{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "paths": { "@/*": ["../src/*"] }
  },
  "include": ["./**/*.ts", "../src/lib/inquiry/**/*.ts", "../src/config/site.ts", "../tests/worker/**/*.ts"]
}
