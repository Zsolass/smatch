{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker project name in the Cloudflare dashboard.
  "name": "labsites",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // `next build` exports the site to ./out before every deploy, preview and `wrangler dev`.
  "build": { "command": "npm run build", "watch_dir": ["src", "public"] },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only the API runs through the Worker; every other path is served straight from ./out.
    "run_worker_first": ["/api/*"]
  },
  // Attaches the custom domain on deploy (Cloudflare creates the DNS record and
  // certificate). Requires the smatch.cloud zone to be in the same account.
  "routes": [{ "pattern": "labsites.smatch.cloud", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": true },
  // Inquiry storage. Wrangler creates the database on the first deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "labsite-inquiries" }],
  "ratelimits": [
    { "name": "INQUIRY_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  // Retries inquiry notifications that failed or were saved before email was configured.
  "triggers": { "crons": ["*/15 * * * *"] },
  // Where inquiry notifications go. RESEND_API_KEY and ADMIN_TOKEN are secrets
  // and are set in the dashboard, not here.
  "vars": {
    "INQUIRY_NOTIFY_TO": "office@smatch.cloud",
    "INQUIRY_NOTIFY_FROM": "Smatch Labsite <labsite@smatch.cloud>"
  },
  // Branch previews (`wrangler preview`, run by Workers Builds for non-main
  // branches) must have this block. Previews get no inquiry database, so the
  // Inquire form on a preview says it isn't set up and never emails the office.
  "previews": {}
}
