{
  "name": "labsite",
  "private": true,
  "description": "Smatch Labsite demo: a dental lab website with a case submission demo and a real website-quote inquiry form",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "render:images": "node scripts/render/render.mjs && python3 scripts/render/post.py",
    "render:og": "node scripts/og-image.mjs",
    "render:demo-files": "python3 scripts/make-demo-files.py"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "libphonenumber-js": "^1.13.15",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
